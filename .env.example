# Docker Compose credentials (generate with: openssl rand -hex 24)
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Database URL. For TiDB Cloud Starter, copy the MySQL URI from Connect.
# Example: mysql://<prefix>.root:<password>@<gateway>.tidbcloud.com:4000/test
DATABASE_URL=mysql://little_moment:change-me@127.0.0.1:3306/little_moment
TIDB_ENABLE_SSL=false
# Optional PEM CA certificate. TiDB Cloud Starter normally trusts Node's built-in CA.
TIDB_CA_CERT=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_BACKEND_MODE=api
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend email delivery for family invitations
RESEND_API_KEY=
RESEND_FROM_EMAIL=Little Moment <onboarding@your-verified-domain.com>
